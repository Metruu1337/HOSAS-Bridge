<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <Version>0.9.0-beta.1</Version>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryType>git</RepositoryType>
    <BuildCommit Condition="'$(BuildCommit)' == ''">uncommitted-local</BuildCommit>
    <BuildTag Condition="'$(BuildTag)' == ''">untagged</BuildTag>
    <Authors>HOSAS Bridge contributors</Authors>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Commit" Value="$(BuildCommit)" />
    <AssemblyMetadata Include="Tag" Value="$(BuildTag)" />
    <AssemblyMetadata Include="Source" Value="$(RepositoryUrl)" />
  </ItemGroup>
</Project>
