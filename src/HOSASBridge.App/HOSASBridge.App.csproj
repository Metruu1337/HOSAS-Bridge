<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework><OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HOSASBridge</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets/bridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/en.json" LogicalName="HOSASBridge.Localization.en.json" />
    <EmbeddedResource Include="Localization/pl.json" LogicalName="HOSASBridge.Localization.pl.json" />
    <ProjectReference Include="../HOSASBridge.Core/HOSASBridge.Core.csproj" />
    <ProjectReference Include="../HOSASBridge.Profiles/HOSASBridge.Profiles.csproj" />
    <ProjectReference Include="../HOSASBridge.Infrastructure/HOSASBridge.Infrastructure.csproj" />
    <ProjectReference Include="../HOSASBridge.Diagnostics/HOSASBridge.Diagnostics.csproj" />
    <ProjectReference Include="../HOSASBridge.Input.DirectInput/HOSASBridge.Input.DirectInput.csproj" />
    <ProjectReference Include="../HOSASBridge.Output.VJoy/HOSASBridge.Output.VJoy.csproj" />
    <ProjectReference Include="../HOSASBridge.DeviceHiding/HOSASBridge.DeviceHiding.csproj" />
    <ProjectReference Include="../HOSASBridge.Setup/HOSASBridge.Setup.csproj" />
    <Content Include="../../dependencies/vJoyInterface.dll" Link="vJoyInterface.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../dependencies/*.exe" Link="dependencies/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../dependencies/*.txt" Link="dependencies/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
