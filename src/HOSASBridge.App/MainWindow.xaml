<Window x:Class="HOSASBridge.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:HOSASBridge.App.Localization" xmlns:views="clr-namespace:HOSASBridge.App.Views" Title="HOSAS Bridge" Width="1120" Height="790" MinWidth="920" MinHeight="650" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
      <StackPanel><TextBlock Text="{DynamicResource LD1D64981D41C}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource L7ADB80F6823B}" Foreground="#536776" Margin="0,4,0,0"/></StackPanel>
      <StackPanel HorizontalAlignment="Right"><TextBlock Text="{DynamicResource L6F0E82A378A6}" FontSize="11" Foreground="#536776"/><TextBlock Text="{Binding Mode, Converter={StaticResource LocalizedValue}}" FontSize="24" Foreground="{StaticResource Accent}" FontWeight="Bold"/></StackPanel>
    </Grid>
    <Border DockPanel.Dock="Bottom" Background="#E7EDF2" CornerRadius="6" Padding="12" Margin="0,15,0,0"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.Name="Application status"/></Border>
    <TabControl SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0">
      <TabItem Header="{DynamicResource L67B696468610}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,0">
        <TextBlock Text="{Binding ProfileLabel}" Style="{StaticResource Heading}"/>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource LEF304FBEAB13}" FontSize="11" Foreground="#536776"/><TextBlock Text="{Binding Bridge}" FontSize="25" FontWeight="SemiBold" Margin="0,6,0,20" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="{DynamicResource LFBE5477B3348}" Command="{Binding Start}" Style="{StaticResource Primary}"/><Button Content="{DynamicResource L93B486CEE793}" Command="{Binding Stop}"/></WrapPanel>
        </StackPanel></Border>
        <UniformGrid Columns="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L45395053A404}" FontWeight="SemiBold"/><TextBlock Text="{Binding Left}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L4C8F480FC4B9}" FontWeight="SemiBold"/><TextBlock Text="{Binding Right}" Margin="0,12,0,0"/></StackPanel></Border></UniformGrid>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource L81D5A5A288E2}" FontWeight="SemiBold"/><TextBlock Text="{Binding VirtualStatus}" TextWrapping="Wrap" Margin="0,8,0,18"/><TextBlock Text="{DynamicResource LC242115AD3C6}" FontWeight="SemiBold"/><TextBlock Text="{Binding Devices.HidingStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <TextBlock Text="{DynamicResource L308236853E6C}" Style="{StaticResource Note}"/>
        <WrapPanel><Button Content="{Binding BaseModeLabel}" Command="{Binding Normal}"/><Button Content="{Binding ActiveModeLabel}" Command="{Binding Minigun}"/><Button Content="{DynamicResource L6E0581B856C1}" Command="{Binding RunSetup}"/></WrapPanel>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource LF64EC16B0D88}"><views:MappingsView DataContext="{Binding Profile}"/></TabItem>
      <TabItem Header="{DynamicResource L9C960C06E804}"><views:AxisTuningView DataContext="{Binding Profile}"/></TabItem>
      <TabItem Header="{DynamicResource LE9C29FF50CC7}"><views:ModesView DataContext="{Binding Modes}"/></TabItem>
      <TabItem Header="{DynamicResource L4BA5121D4D1B}"><views:DevicesView/></TabItem>
      <TabItem Header="{DynamicResource L268F14BBFE11}"><views:DiagnosticsView DataContext="{Binding Diagnostics}"/></TabItem>
      <TabItem Header="{DynamicResource L74A883A037BC}"><views:SettingsView DataContext="{Binding Settings}"/></TabItem>
    <TabItem Header="{loc:Text About}"><views:AboutView DataContext="{Binding About}"/></TabItem></TabControl>
  </DockPanel>
</Window>
